# Required
WECOM_CORP_ID=your_corp_id
WECOM_TOKEN=your_token
WECOM_AES_KEY=your_43_char_aes_key  # 43 chars, from callback config

# Server
PORT=3000

# Optional: set to "true" to auto-reply to incoming text messages
AUTO_REPLY_TEXT=false
OPENAI_API_KEY=your_openai_api_key
WECOM_APP_SECRET=your_wecom_app_secret
WECOM_AGENT_ID=1000003
